#!/bin/bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y docker.io docker-compose-v2
systemctl enable --now docker
install -d /opt/showpad

cat > /opt/showpad/compose.yaml <<'COMPOSE'
services:
  api:
    image: ${image}
    pull_policy: never
    restart: unless-stopped
    ports:
      - "80:3000"
    environment:
      STORAGE: redis
      REDIS_URL: redis://redis:6379
    depends_on:
      redis:
        condition: service_healthy
    logging:
      options:
        max-size: "10m"
        max-file: "3"
  redis:
    image: redis:8.2-alpine
    restart: unless-stopped
    command: ["redis-server", "--appendonly", "yes", "--appendfsync", "everysec"]
    volumes:
      - redis-data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 1s
      timeout: 3s
      retries: 10
    logging:
      options:
        max-size: "10m"
        max-file: "3"
volumes:
  redis-data:
COMPOSE

cat > /etc/systemd/system/showpad.service <<'SERVICE'
[Unit]
Description=Showpad API and Redis
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/showpad
ExecStart=/usr/bin/docker compose up --remove-orphans
ExecStop=/usr/bin/docker compose down
Restart=on-failure
RestartSec=30
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable --now --no-block showpad
