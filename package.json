{
  "name": "showpad-throttling",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "test": "node --import tsx --test test/*.test.ts",
    "test:integration": "node --import tsx --test test/integration/*.test.ts",
    "test:watch": "node --import tsx --test --watch test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm test && pnpm format:check && pnpm build"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "redis": "^5.12.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
